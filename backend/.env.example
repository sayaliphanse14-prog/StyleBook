# Rename this file to .env before running the backend

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/stylebook

# OR MongoDB Atlas (cloud) - replace with your own connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stylebook

PORT=5000

# Any long random string works - used to sign JWT tokens
JWT_SECRET=stylebook_super_secret_key_change_this
